# Reference of every setting read from the environment.
# - Docker: not needed, docker-compose.yml already defines development values.
# - Without Docker (e.g. SQLite): copy to `.env` and adjust.
# - Production: set these as the hosting provider's environment variables.

DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (default) or SQLite: sqlite:///db.sqlite3
DATABASE_URL=postgres://wh:wh@localhost:5432/wh

# smtp://host:port for Mailpit, consolemail:// to print emails in the console
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Wynwood House <reservas@example.com>

TIME_ZONE=America/Lima
ADMIN_URL=admin/

# Production security (enabled automatically when DEBUG=false)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
